{
  "entities": {
    "User": {
      "title": "User",
      "description": "Usuário do sistema SIG Olor Luz",
      "type": "object",
      "properties": {
        "nome": { "type": "string", "description": "Nome do vendedor ou administrador" },
        "email": { "type": "string", "description": "Email do usuário" },
        "tipo": { "type": "string", "enum": ["Master", "Vendedor"], "description": "Nível de acesso" }
      },
      "required": ["nome", "email", "tipo"]
    },
    "Venda": {
      "title": "Venda",
      "description": "Registro de venda ou lançamento no sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "string" },
        "idSaida": { "type": "string" },
        "vendedor": { "type": "string" },
        "tabelaPreco": { "type": "string" },
        "tipoSaida": { "type": "string" },
        "produto": { "type": "string" },
        "embalagem": { "type": "string" },
        "quantidade": { "type": "number" },
        "modificador": { "type": "number" },
        "precoUni": { "type": "number" },
        "precoVenda": { "type": "number" },
        "comissao": { "type": "number" },
        "statusComissao": { "type": "string" },
        "dia": { "type": "number" },
        "mes": { "type": "number" },
        "ano": { "type": "number" },
        "obs": { "type": "string" },
        "clienteInfluenciador": { "type": "string" },
        "contato": { "type": "string" }
      },
      "required": ["data", "vendedor", "produto", "embalagem", "quantidade"]
    },
    "Formula": {
      "title": "Formula",
      "description": "Fórmula química/aromática de produto com insumos, quantidades, metodologias e custos para P&D e Engenharia",
      "type": "object",
      "properties": {
        "produto": { "type": "string", "description": "Nome do produto ou fragrância" },
        "status": { "type": "string", "enum": ["Ativo", "Inativo", "Teste"], "description": "Status do produto na formulação" },
        "isCriacaoLivre": { "type": "boolean", "description": "Se a fórmula foi criada em modo laboratório livre" },
        "rendimento": { "type": "number", "description": "Rendimento do lote de teste ou padrão" },
        "unidadeRendimento": { "type": "string", "enum": ["L", "ml", "Kg", "g"], "description": "Unidade de rendimento do lote" },
        "custoTotal": { "type": "number", "description": "Custo total dos insumos do lote" },
        "custoUnitarioLitro": { "type": "number", "description": "Custo unitário normalizado por litro (R$/L)" },
        "insumos": { "type": "array", "description": "Lista dinâmica de insumos e matérias-primas da receita" },
        "obs": { "type": "string", "description": "Observações gerais da fórmula" }
      },
      "required": ["produto", "status", "insumos"]
    }
  },
  "firestore": {
    "/usuarios/{userId}": {
      "schema": "User",
      "description": "Coleção de perfis de usuários com RBAC"
    },
    "/vendas/{vendaId}": {
      "schema": "Venda",
      "description": "Coleção de pedidos e vendas da Olor Luz"
    },
    "/formulas/{formulaId}": {
      "schema": "Formula",
      "description": "Coleção de fórmulas de produtos e fragrâncias da Olor Luz"
    }
  }
}
